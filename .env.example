# ---- Instagram (from the Meta app: Instagram → API setup with Instagram login) ----
# Each business's own token is stored encrypted, in the database, with DATA_KEY. See npm run tenant -- ig-token.
# Instagram app secret (used to verify webhook signatures). If webhooks get rejected with
# "bad signature", use App settings → Basic → App secret instead.
APP_SECRET=
# Any string you choose; enter the same value in Meta's webhook settings
VERIFY_TOKEN=pick-a-random-string
GRAPH_VERSION=v23.0
# Empty is Instagram itself. Local runs point this at a simulator.
GRAPH_BASE_URL=
# 1 = only log DMs instead of sending them
DRY_RUN=0
# 1 = each person gets at most one DM per reel
ONE_DM_PER_USER=0

# ---- Website ----
PORT=3000
# The public address of this server, used for the store link inside DMs.
# Codespaces example: https://your-codespace-3000.app.github.dev
PUBLIC_BASE_URL=
# /admin is always the React seller console (npm run build:console first). This setting no longer changes that.
ADMIN_UI=

# ---- Store owner ----
# The owner logs in on /login with this mobile number + password and gets the admin panel (/admin).
# The account is created (or its password reset) every time the server starts.
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=choose-a-strong-password
# Long random string; keeps everyone logged in across restarts
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Database ----
# Postgres is the only runtime database: the server and worker refuse to start without this.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# 1 = quick local run on the built-in database in data/pgdata (one process at a time)
ALLOW_PGLITE=0

# ---- Businesses (Bhava) ----
# Each business is served on <slug>.PLATFORM_DOMAIN (e.g. mehtamart.bhavahq.com) or a custom domain.
# PLATFORM_DOMAIN=bhavahq.com
PLATFORM_DOMAIN=
# Where Bhava's own team signs in. Empty means admin.PLATFORM_DOMAIN.
PLATFORM_HOST=
# The business served on any other address, created on start if missing. Webhooks for Instagram
# accounts not linked to a business also go to it. Leave empty once every business has its own address.
DEFAULT_TENANT=default
DEFAULT_TENANT_NAME=My store

# ---- Switchable modules (QA defaults; production changes only these) ----
# Files: local folder on the server, or S3-compatible object storage (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
# STORAGE_DIR=/data/files
# S3_BUCKET=  S3_REGION=  S3_ENDPOINT=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=  S3_FORCE_PATH_STYLE=1
# Background jobs and cache: Postgres / in-memory now; Redis in production (REDIS_URL=redis://...).
QUEUE_DRIVER=pg
CACHE_DRIVER=memory
# REDIS_URL=
# Analytics events: main Postgres now; a separate ClickHouse database in production.
ANALYTICS_DRIVER=pg
# CLICKHOUSE_URL=http://user:pass@clickhouse:8123  CLICKHOUSE_DB=bhava
# Encrypts stored tokens and keys. 32 random bytes, base64:
#   node -p "require('crypto').randomBytes(32).toString('base64')"
DATA_KEY=
# /metrics needs Authorization: Bearer <METRICS_TOKEN>; hidden when empty.
METRICS_TOKEN=
# LOG_FORMAT=pretty for readable logs while developing (default: JSON lines)
