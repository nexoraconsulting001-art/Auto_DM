# ---- Instagram (from the Meta app: Instagram → API setup with Instagram login) ----
# Each business's own token is stored encrypted, in the database, with DATA_KEY. See npm run tenant -- ig-token.
# Instagram app secret (used to verify webhook signatures). If webhooks get rejected with
# "bad signature", use App settings → Basic → App secret instead.
APP_SECRET=
# Any string you choose; enter the same value in Meta's webhook settings
VERIFY_TOKEN=pick-a-random-string
GRAPH_VERSION=v23.0
# Empty is Instagram itself. Local runs point this at a simulator, and every Meta address below follows it unless set.
# A simulator address is refused when NODE_ENV=production, and any address that is not Meta's is always refused.
GRAPH_BASE_URL=
# IG_DIALOG_BASE_URL=  IG_API_BASE_URL=  FB_GRAPH_BASE_URL=  FB_DIALOG_BASE_URL=
# The one address registered with Meta for login redirects and callbacks. Empty means PUBLIC_BASE_URL.
# META_CALLBACK_BASE_URL=
# How long a call to Meta may take, in milliseconds.
# META_TIMEOUT_MS=10000
# Empty is Google itself, for the seller's own GA4 property. Local runs point this at a simulator, which is refused when NODE_ENV=production.
GA4_BASE_URL=
# Ask Meta for read receipts, for the funnel's Seen step. Leave off until confirmed for Instagram Login.
# READ_RECEIPTS=1
# Which login connects Instagram: instagram (Instagram Login) or unified (Facebook Login for Business).
META_LOGIN=instagram
# The Instagram app id, next to APP_SECRET in Meta's dashboard.
IG_APP_ID=
# Facebook Login is a separate Meta app: used for Facebook Pages, and for Instagram when META_LOGIN=unified.
FB_APP_ID=
FB_APP_SECRET=
# 1 = offer Facebook Pages to businesses
FACEBOOK_PAGES=0
# 1 = only log DMs instead of sending them
DRY_RUN=0
# 1 = each person gets at most one DM per reel
ONE_DM_PER_USER=0

# ---- Website ----
PORT=3000
# The public address of this server, used for the store link inside DMs.
# Codespaces example: https://your-codespace-3000.app.github.dev
PUBLIC_BASE_URL=
# /admin is always the React seller console (npm run build:console first). This setting no longer changes that.
ADMIN_UI=

# ---- Store owner ----
# The owner logs in on /login with this mobile number + password and gets the admin panel (/admin).
# The account is created (or its password reset) every time the server starts.
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=choose-a-strong-password
# Long random string; keeps everyone logged in across restarts
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Database ----
# Postgres is the only runtime database: the server and worker refuse to start without this.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Production: two logins on the same database. DATABASE_URL then logs in as the restricted role bhava_app (all business
# work: it owns nothing and cannot get around row-level security), and DATABASE_OWNER_URL as the owner of the tables
# (database changes on start, backups, restores and the platform paths). The first start makes the bhava_app login
# with the password in DATABASE_URL. Left empty, DATABASE_URL is the owner and does both, with a warning in production.
# DATABASE_URL=postgresql://bhava_app:password@host/dbname?sslmode=require
# DATABASE_OWNER_URL=postgresql://owner:password@host/dbname?sslmode=require
DATABASE_OWNER_URL=
# 1 = quick local run on the built-in database in data/pgdata (one process at a time)
ALLOW_PGLITE=0

# ---- Businesses (Bhava) ----
# Each business is served on <slug>.PLATFORM_DOMAIN (e.g. mehtamart.shopsdomain.example) or a custom domain.
# PLATFORM_DOMAIN=shopsdomain.example
PLATFORM_DOMAIN=
# Where Bhava's own team signs in. Empty means admin.PLATFORM_DOMAIN.
PLATFORM_HOST=
# Where sellers sign in: the owner app and the web sign-in page use /api/v1 on this host. It belongs to no business.
# Empty means app.PLATFORM_DOMAIN.
PLATFORM_APP_HOST=

# ---- Seller sign-in (no passwords) ----
# Sellers sign in with a WhatsApp code, Google or Apple. 1 keeps the old phone-and-password login, for tests and local
# runs only: it is on by default under NODE_ENV=test, off otherwise, and the server refuses to start with it in production.
# PASSWORD_LOGIN=0
# An access token lasts this many minutes; a refresh token this many days, and is replaced every time it is used.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=60
# Google sign-in for sellers: its own OAuth client (the shoppers' one is GOOGLE_CLIENT_ID).
SELLER_GOOGLE_CLIENT_ID=
SELLER_GOOGLE_CLIENT_SECRET=
# Empty is Google itself. Local runs point this at the Google simulator (sign-in page, code exchange and signing keys),
# which is refused when NODE_ENV=production.
GOOGLE_KEYS_BASE_URL=
# Sign in with Apple: who a token may be for, comma separated (the owner app's bundle id, the Services ID for the web).
APPLE_SIGNIN_AUDIENCES=
# Empty is Apple itself. Local runs point this at the Apple simulator, which is refused when NODE_ENV=production.
APPLE_KEYS_BASE_URL=
# ---- Messages to sellers (from Bhava itself; never to a shopper) ----
# Bhava's own WhatsApp Business number: login codes and alerts. Empty: sellers are offered Google sign-in instead.
PLATFORM_WHATSAPP_PHONE_ID=
PLATFORM_WHATSAPP_TOKEN=
# Rename templates when the approved names differ: login_code=bhava_code_v2,bhava_order_new=order_new_v3
# PLATFORM_WHATSAPP_TEMPLATES=
# Bhava's email sender, over EMAIL_DRIVER. Empty: no email to sellers.
PLATFORM_EMAIL_FROM=
# Push to the owner app: none, fcm, apns or fcm,apns. One FCM project and one APNs key serve every business.
PUSH_DRIVER=none
# FCM_PROJECT_ID=  FCM_SERVICE_ACCOUNT=<the service account JSON, or its base64>
# APNS_KEY_ID=  APNS_TEAM_ID=  APNS_TOPIC=<bundle id>  APNS_KEY=<the .p8, or its base64>  APNS_ENV=production
# Local runs point these at tools/sim/push, which is refused when NODE_ENV=production.
# FCM_BASE_URL=  APNS_BASE_URL=
# App Review's fixed login: the review number (+91...) and the hash of its code. Leave both empty to turn it off.
REVIEW_LOGIN_PHONE=
REVIEW_LOGIN_CODE_HASH=
# The business served on any other address, created on start if missing. Webhooks for Instagram
# accounts not linked to a business also go to it. Leave empty once every business has its own address.
DEFAULT_TENANT=default
DEFAULT_TENANT_NAME=My store

# ---- Switchable modules (QA defaults; production changes only these) ----
# Files: local folder on the server, or S3-compatible object storage (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
# STORAGE_DIR=/data/files
# S3_BUCKET=  S3_REGION=  S3_ENDPOINT=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=  S3_FORCE_PATH_STYLE=1
# Background jobs and cache: Postgres / in-memory now; Redis in production (REDIS_URL=redis://...).
QUEUE_DRIVER=pg
CACHE_DRIVER=memory
# REDIS_URL=
# Analytics events: main Postgres now; a separate ClickHouse database in production.
ANALYTICS_DRIVER=pg
# CLICKHOUSE_URL=http://user:pass@clickhouse:8123  CLICKHOUSE_DB=bhava
# Imports and theme reads ask one outside site at most once per this many milliseconds, across every business (PRD 8.2).
# FETCH_HOST_GAP_MS=1000
# Encrypts stored tokens and keys. 32 random bytes, base64:
#   node -p "require('crypto').randomBytes(32).toString('base64')"
DATA_KEY=
# /metrics needs Authorization: Bearer <METRICS_TOKEN>; hidden when empty.
METRICS_TOKEN=
# LOG_FORMAT=pretty for readable logs while developing (default: JSON lines)
