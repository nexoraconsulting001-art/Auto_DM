# Every variable compose.yaml reads. Copy to .env next to it and fill in. None of these is a secret: secrets are
# files under SECRETS_HOST_DIR (README.md here). The values below are placeholders (example.com, set-me).

# The images, built from the repository's Dockerfile (--target web and --target worker), by tag or digest.
BHAVA_WEB_IMAGE=registry.example.com/bhava/bhava-web:0.0.0-set-me
BHAVA_WORKER_IMAGE=registry.example.com/bhava/bhava-worker:0.0.0-set-me
RELEASE=0.0.0-set-me

# Where the secret files are on this host: app/ (one file per setting), lb/ (origin.crt, origin.key),
# redis/redis.conf and analytics/users.xml. Readable by uid 1000 only.
SECRETS_HOST_DIR=/srv/bhava/secrets

# The platform's hosts.
PLATFORM_DOMAIN=example.com
PLATFORM_HOST=app.example.com
PUBLIC_BASE_URL=https://app.example.com

# Object storage (outside, S3-compatible). The region is an India region from deploy/prod/regions.json.
S3_ENDPOINT=https://objects.example.com
S3_BUCKET=bhava-files
S3_REGION=set-me
S3_FORCE_PATH_STYLE=0
BACKUP_S3_ENDPOINT=https://objects.example.com
BACKUP_S3_BUCKET=bhava-backups
BACKUP_S3_REGION=set-me

# The analytics database's name inside the analytics service.
CLICKHOUSE_DB=bhava

# The load balancer: the ACME account's email for sellers' domains, and the address ranges of the proxy in front
# (Cloudflare publishes its list; space-separated CIDRs).
ACME_EMAIL=ops@example.com
TRUSTED_PROXY_RANGES=192.0.2.0/24
