# Copy to deploy/.env on the VM (never commit it): cp .env.example .env && nano .env

# ---- Website ----
PUBLIC_BASE_URL=https://mehtamart.140-238-251-141.sslip.io

# ---- Store owner: logs in on /login and gets the admin panel ----
ADMIN_PHONE=
ADMIN_PASSWORD=
# Long random string, e.g. from: openssl rand -hex 32
SESSION_SECRET=

# ---- Instagram (Meta app → Instagram → API setup with Instagram login) ----
IG_ACCESS_TOKEN=
IG_USER_ID=
APP_SECRET=
VERIFY_TOKEN=
GRAPH_VERSION=v23.0
DRY_RUN=0
ONE_DM_PER_USER=0

# ---- Sharing this Instagram account with the Auto DM plugin (optional) ----
# Comments on reels this store doesn't use are passed on, unchanged, to the plugin's webhook.
FORWARD_WEBHOOK_URL=
# DM links from the plugin (/l/<slug>) are redirected to PLUGIN_URL/r/<slug>.
PLUGIN_URL=

# ---- Database ----
# Empty = built-in database in the /data volume (DATA_DIR is set in compose.yaml).
DATABASE_URL=

# ---- Businesses (Bhava) ----
# <slug>.PLATFORM_DOMAIN serves each business; DEFAULT_TENANT serves every other address.
PLATFORM_DOMAIN=
DEFAULT_TENANT=default
DEFAULT_TENANT_NAME=My store
