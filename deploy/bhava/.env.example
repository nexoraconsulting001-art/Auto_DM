# Copy to deploy/bhava/.env on the VM. Secrets live only there, never in git or chat.

# Letters and numbers only (it goes inside a connection string): openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
# node -p "require('crypto').randomBytes(32).toString('base64')"
DATA_KEY=
# openssl rand -hex 24
METRICS_TOKEN=

# ---- Businesses ----
# Each business is served on <slug>.PLATFORM_DOMAIN.
PLATFORM_DOMAIN=qa.example.com
# Where Bhava's team signs in. Empty means admin.PLATFORM_DOMAIN.
PLATFORM_HOST=
# Empty on QA: an address with no business shows "no store here".
DEFAULT_TENANT=

# ---- Bhava's own Meta app in Development mode. Each business's Instagram token is stored encrypted. ----
APP_SECRET=
VERIFY_TOKEN=
# Keep DMs from really sending until the Compliance Engine is in (Phase 1).
DRY_RUN=1

# ---- Modules: QA drivers ----
STORAGE_DRIVER=local
QUEUE_DRIVER=pg
ANALYTICS_DRIVER=pg
CACHE_DRIVER=memory

# ---- Nightly backup to Oracle Object Storage (S3-compatible). Empty driver = no backups. ----
BACKUP_STORAGE_DRIVER=s3
BACKUP_S3_BUCKET=bhava-qa-backups
# ap-mumbai-1, ap-hyderabad-1, ...: the region the bucket is in
BACKUP_S3_REGION=
# https://<object storage namespace>.compat.objectstorage.<region>.oraclecloud.com
BACKUP_S3_ENDPOINT=
# Oracle Console > your profile > Customer secret keys
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
