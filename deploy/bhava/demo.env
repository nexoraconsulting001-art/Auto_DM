# Demo profile (non-secret): the QA server runs outside production mode so the test copies in tools/sim can stand in for
# Razorpay, Shiprocket, WhatsApp and Shopify. Instagram stays REAL: no Meta address is set here.
# Test keys and passwords for the copies go in .env on the VM, never here. See compose.demo.yaml.
NODE_ENV=staging
RAZORPAY_BASE_URL=http://127.0.0.1:9103
RAZORPAY_AUTH_BASE_URL=http://127.0.0.1:9103
SHIPROCKET_BASE_URL=http://127.0.0.1:9104
WHATSAPP_BASE_URL=http://127.0.0.1:9102
SHOPIFY_BASE_URL=http://127.0.0.1:9105
