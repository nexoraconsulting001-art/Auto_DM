{
  "name": "@bhava/console",
  "version": "0.1.0",
  "private": true,
  "description": "Seller console (console/dist, at /admin on each business's address) and the Platform Console (console/dist-platform, at /console on the platform host only): React and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.platform.config.js",
    "build:seller": "vite build",
    "build:platform": "vite build --config vite.platform.config.js",
    "dev:platform": "vite --config vite.platform.config.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@bhava/api-client": "*",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.7"
  }
}
