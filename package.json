{
  "name": "auto-dm",
  "version": "0.1.0",
  "private": true,
  "description": "Instagram reel comment-to-DM automation with a shoppable store per reel and an admin panel",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "console",
    "shared/*"
  ],
  "scripts": {
    "start": "node src/server.js",
    "build:console": "npm run build --workspace console",
    "dev:console": "npm run dev --workspace console",
    "worker": "node src/worker.js",
    "tenant": "node scripts/tenant.js",
    "platform-user": "node scripts/platform-user.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "seed": "node scripts/seed.js",
    "role": "node scripts/role.js",
    "test": "node --import ./tools/net-guard.mjs --test --test-force-exit --test-concurrency=4 \"test/**/*.test.js\"",
    "test:ci": "node --import ./tools/net-guard.mjs --test --test-force-exit --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tools/ci-annotate.mjs --test-reporter-destination=stdout \"test/**/*.test.js\"",
    "test:phase": "node tools/test-phase.mjs",
    "gate": "node tools/gate.mjs",
    "ledger": "node tools/ledger.mjs",
    "secret-scan": "node tools/secret-scan.mjs",
    "ci:wait": "node tools/ci-wait.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@electric-sql/pglite": "^0.2.17",
    "bullmq": "^5.81.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "embedded-postgres": "16.15.0-beta.19",
    "fast-check": "^4.10.2"
  }
}
